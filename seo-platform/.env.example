NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL_ALLOWLIST=

# Server-only. Never prefix with NEXT_PUBLIC_ and never expose to browser bundles.
SUPABASE_SERVICE_ROLE_KEY=

# Public SEO origin override (optional). When unset, Vercel deployments use the
# fixed public domain (https://place.xn--hq1bo4e93ri3lbmc.com) and local dev uses localhost.
# NEXT_PUBLIC_SITE_URL=https://place.xn--hq1bo4e93ri3lbmc.com

# App (admin/auth) origin default used by password-reset redirects. Public SEO
# surfaces (sitemap/robots/canonical/OG/JSON-LD) no longer read this variable.
SEO_PLATFORM_SITE_URL=http://localhost:3000
SEO_PLATFORM_BRAND_NAME=팔도플라워 SEO Platform
SEO_PLATFORM_DEFAULT_ORDER_URL=https://팔도플라워.com
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Server-only Google Sheets sync credentials. Never expose service-account JSON to the browser.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=기업 DB
GOOGLE_SHEET_RANGE=A:M
