SEO_PLATFORM_DEFAULT_ORDER_URL=https://팔도플라워.com
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# Server-only Google Sheets sync credentials. Never expose service-account JSON to the browser.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=기업 DB
GOOGLE_SHEET_RANGE=A:M
